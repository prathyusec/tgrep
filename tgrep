#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
tgrep — Telegram-style fuzzy search for the Kali terminal.
"""

import argparse
import curses
import os
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "1.1.0"
MAX_RESULTS = 2000

HISTORY_FILES = [
    Path.home() / ".bash_history",
    Path.home() / ".zsh_history",
    Path.home() / ".local/share/fish/fish_history",
]


def load_history():
    entries = []
    for hf in HISTORY_FILES:
        if not hf.exists():
            continue
        try:
            with open(hf, "r", errors="ignore") as f:
                for line in f:
                    line = line.rstrip("\n")
                    if not line:
                        continue
                    if line.startswith(": ") and ";" in line:
                        line = line.split(";", 1)[1]
                    entries.append(line)
        except OSError:
            continue
    seen, out = set(), []
    for e in reversed(entries):
        if e not in seen:
            seen.add(e)
            out.append(e)
    return out


def load_files(root):
    root = Path(root).expanduser().resolve()
    cwd = Path.cwd()
    out = []
    for p in root.rglob("*"):
        try:
            if p.is_file():
                try:
                    out.append(str(p.relative_to(cwd)))
                except ValueError:
                    out.append(str(p))
                if len(out) >= 20000:
                    break
        except OSError:
            continue
    return out


def load_stdin():
    return [line.rstrip("\n") for line in sys.stdin if line.strip()]


def fuzzy(query, text):
    if not query:
        return 0, []
    q, t = query.lower(), text.lower()
    qi, pos, score, last = 0, [], 0, -2
    for i, ch in enumerate(t):
        if qi < len(q) and ch == q[qi]:
            pos.append(i)
            score += 1
            if last == i - 1:
                score += 5
            if i == 0 or t[i - 1] in " /-_.:":
                score += 3
            last = i
            qi += 1
    if qi != len(q):
        return None
    score -= len(t) // 60
    return score, pos


def copy_to_clipboard(text):
    for cmd in (["wl-copy"],
                ["xclip", "-selection", "clipboard"],
                ["xsel", "--clipboard", "--input"]):
        if shutil.which(cmd[0]):
            try:
                p = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                     stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
                p.communicate(text.encode())
                if p.returncode == 0:
                    return True
            except OSError:
                continue
    return False


class App:
    def __init__(self, stdscr, args):
        self.stdscr = stdscr
        self.args = args
        if args.pipe:
            self.mode = "pipe"
        elif args.files:
            self.mode = "files"
        else:
            self.mode = "history"
        self.entries = []
        self.query = args.query or ""
        self.results = []
        self.cursor = 0
        self.offset = 0
        self.status = ""
        self.colors = curses.has_colors()
        if self.colors:
            curses.start_color()
            try:
                curses.use_default_colors()
                curses.init_pair(1, curses.COLOR_YELLOW, -1)
                curses.init_pair(2, curses.COLOR_CYAN, -1)
                curses.init_pair(3, curses.COLOR_GREEN, -1)
            except curses.error:
                self.colors = False
        self.reload()

    def reload(self):
        if self.mode == "history":
            self.entries = load_history()
        elif self.mode == "pipe":
            self.entries = load_stdin()
        else:
            self.entries = load_files(self.args.directory or ".")
        self.refresh_results()

    def refresh_results(self):
        q = self.query.strip()
        if not q:
            self.results = [(0, e, []) for e in self.entries[:MAX_RESULTS]]
        else:
            scored = []
            for e in self.entries:
                m = fuzzy(q, e)
                if m:
                    scored.append((m[0], e, m[1]))
            scored.sort(key=lambda x: (-x[0], len(x[1])))
            self.results = scored[:MAX_RESULTS]
        self.cursor = 0
        self.offset = 0

    def draw(self):
        s = self.stdscr
        s.erase()
        h, w = s.getmaxyx()
        if h < 4 or w < 20:
            s.refresh()
            return
        title = f" tgrep v{VERSION}  ·  {self.mode} "
        s.addstr(0, 0, title[:w - 1].ljust(w - 1), curses.A_REVERSE)
        prompt = " Search: "
        s.addstr(1, 0, prompt, curses.A_BOLD)
        qx = len(prompt)
        avail = max(1, w - qx - 2)
        qtext = self.query[-avail:]
        try:
            s.addstr(1, qx, qtext)
            s.move(1, qx + len(qtext))
        except curses.error:
            pass
        try:
            s.addstr(2, 0, "─" * (w - 1))
        except curses.error:
            pass
        top = 3
        list_h = max(1, h - top - 1)
        if self.cursor < self.offset:
            self.offset = self.cursor
        if self.cursor >= self.offset + list_h:
            self.offset = self.cursor - list_h + 1
        if not self.results:
            try:
                s.addstr(top + 1, 2, "  (no matches)", curses.A_DIM)
            except curses.error:
                pass
        for i in range(list_h):
            idx = self.offset + i
            if idx >= len(self.results):
                break
            _, text, pos = self.results[idx]
            y = top + i
            selected = (idx == self.cursor)
            base = curses.A_REVERSE if selected else 0
            num = f"{idx + 1:>5} "
            try:
                s.addstr(y, 0, num, base | (0 if selected else curses.A_DIM))
            except curses.error:
                pass
            self._draw_line(y, len(num), text, pos, base,
                            w - len(num) - 1, selected)
        if self.status:
            status = f" {self.status} "
            self.status = ""
        else:
            status = (f" {len(self.results)}/{len(self.entries)}  "
                      f"↑↓ move  Enter select  Ctrl+Y copy  "
                      f"Ctrl+E exec  Ctrl+F mode  Esc quit ")
        try:
            s.addstr(h - 1, 0, status[:w - 1].ljust(w - 1), curses.A_REVERSE)
        except curses.error:
            pass
        s.refresh()

    def _draw_line(self, y, x, text, positions, base, maxw, selected):
        if maxw <= 0:
            return
        pos_set = set(positions)
        for i, ch in enumerate(text):
            if i >= maxw:
                break
            attr = base
            if i in pos_set:
                if selected:
                    attr = base | curses.A_BOLD
                elif self.colors:
                    attr = curses.color_pair(1) | curses.A_BOLD
                else:
                    attr = curses.A_BOLD | curses.A_UNDERLINE
            try:
                self.stdscr.addstr(y, x + i, ch, attr)
            except curses.error:
                break

    def run(self):
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        self.stdscr.keypad(True)
        while True:
            self.draw()
            try:
                ch = self.stdscr.getch()
            except KeyboardInterrupt:
                return None, None
            if ch == -1 or ch == curses.KEY_RESIZE:
                continue
            if ch in (27, 3):
                return None, None
            elif ch == curses.KEY_UP:
                if self.cursor > 0:
                    self.cursor -= 1
            elif ch == curses.KEY_DOWN:
                if self.cursor < len(self.results) - 1:
                    self.cursor += 1
            elif ch == curses.KEY_PPAGE:
                self.cursor = max(0, self.cursor - 10)
            elif ch == curses.KEY_NPAGE:
                self.cursor = min(max(0, len(self.results) - 1),
                                  self.cursor + 10)
            elif ch == curses.KEY_HOME:
                self.cursor = 0
            elif ch == curses.KEY_END:
                self.cursor = max(0, len(self.results) - 1)
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if self.query:
                    self.query = self.query[:-1]
                    self.refresh_results()
            elif ch == 21:
                if self.query:
                    self.query = ""
                    self.refresh_results()
            elif ch == 25:
                if self.results:
                    txt = self.results[self.cursor][1]
                    ok = copy_to_clipboard(txt)
                    self.status = "✓ copied!" if ok else "clipboard tool not found"
            elif ch == 5:
                if self.results:
                    return "exec", self.results[self.cursor][1]
            elif ch == 6:
                if self.mode == "pipe":
                    self.status = "cannot toggle mode in pipe mode"
                else:
                    self.mode = "files" if self.mode == "history" else "history"
                    self.query = ""
                    self.reload()
            elif ch in (10, 13, curses.KEY_ENTER):
                if self.results:
                    return "print", self.results[self.cursor][1]
            elif 32 <= ch < 127:
                self.query += chr(ch)
                self.refresh_results()


def main():
    ap = argparse.ArgumentParser(
        prog="tgrep",
        description="Telegram-style fuzzy search for the Kali terminal.",
    )
    ap.add_argument("query", nargs="?", default="", help="initial query")
    ap.add_argument("-f", "--files", action="store_true",
                    help="search files instead of shell history")
    ap.add_argument("-d", "--directory", default=".",
                    help="directory to search in files mode (default: .)")
    ap.add_argument("-p", "--pipe", action="store_true",
                    help="read lines from stdin (pipe mode)")
    ap.add_argument("-v", "--version", action="version",
                    version=f"tgrep {VERSION}")
    args = ap.parse_args()
    if args.pipe:
        if sys.stdin.isatty():
            print("tgrep: -p requires input on stdin", file=sys.stderr)
            return 1
    elif not sys.stdout.isatty():
        print("tgrep: interactive mode requires a TTY", file=sys.stderr)
        return 1
    try:
        action, value = curses.wrapper(lambda s: App(s, args).run())
    except KeyboardInterrupt:
        return 130
    if action == "print" and value:
        print(value)
    elif action == "exec" and value:
        print(f"[tgrep] $ {value}", file=sys.stderr)
        os.execvp("bash", ["bash", "-c", value])
    return 0


if __name__ == "__main__":
    sys.exit(main())
